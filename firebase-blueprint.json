{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with preferences",
      "type": "object",
      "properties": {
        "hasCompletedOnboarding": { "type": "boolean" },
        "language": { "type": "string", "enum": ["en", "si"] },
        "goals": { "type": "array", "items": { "type": "string" } },
        "receiveDailyDrops": { "type": "boolean" },
        "isGuided": { "type": "boolean" },
        "name": { "type": "string" }
      },
      "required": ["hasCompletedOnboarding", "language", "goals", "receiveDailyDrops", "isGuided"]
    },
    "DailyWisdom": {
      "title": "Daily Wisdom",
      "description": "Daily quote, source and reflection",
      "type": "object",
      "properties": {
        "quote": { "type": "string" },
        "source": { "type": "string" },
        "reflection": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["quote", "source", "reflection", "timestamp"]
    },
    "Contact": {
      "title": "Contact",
      "description": "User contact message",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "message": { "type": "string" },
        "createdAt": { "type": "object" },
        "to": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["name", "email", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user preferences"
    },
    "/daily_wisdom/{wisdomId}": {
      "schema": "DailyWisdom",
      "description": "Global daily wisdom entries"
    },
    "/contacts/{contactId}": {
      "schema": "Contact",
      "description": "User feedback and messages"
    }
  }
}
